generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id          String   @id
  sku         String   @unique
  title       String
  subtitle    String
  slug        String   @unique
  description String
  type        String
  brand       String
  category    String
  priceCents  Int      @map("price_cents")
  currency    String
  available   Boolean
  stock       Int
  colors      String[]
  sizes       String[]
  materials   String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}
